{
  "schemaVersion": 1,
  "id": "mcef_vulkan",
  "version": "${vulkan_addon_version}",
  "name": "MCEF VulkanMod Add-on",
  "description": "Uploads MCEF's completed Chromium frames through VulkanMod's GPU backend without replacing Chromium or MCEF.",
  "environment": "client",
  "license": "LGPL-2.1-or-later",
  "mixins": [
    "mcef-vulkan-addon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "mcef": "${mod_version}",
    "vulkanmod": ">=${vulkanmod_min_version}"
  }
}
